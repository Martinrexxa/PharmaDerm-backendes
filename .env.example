PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_super_secret_value

# Primary frontend URL for CORS
FRONTEND_URL=http://localhost:5173
# Optional additional origins (comma-separated)
FRONTEND_URLS=

# Public backend URL used in verification links
API_PUBLIC_URL=http://localhost:3000

# PostgreSQL connection string (Render/Supabase Postgres)
DATABASE_URL=

# Preferred: Brevo API (recommended on Render)
BREVO_API_KEY=

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PharmaDerm <no-reply@pharmaderm.com>"
